    {
      "id": "text-20",
      "type": "text",
      "x": 1083.1654035576275,
      "y": 223.18894411476288,
      "width": 860.03759765625,
      "height": 332.14283098493297,
      "backgroundColor": "transparent",
      "strokeStyle": "solid",
      "roundness": null,
      "boundElements": [],
      "text": "Data ownership rules\n\n    1. Two users can both have a task called\n      \"buy milk\", but each user only sees their own tasks.\n\n    2. A user can only change or delete their own tasks\n \n    3. Without a valid token, no tasks\n       can be reached at all.",
      "originalText": "Data ownership rules\n\n    1. Two users can both have a task called\n      \"buy milk\", but each user only sees their own tasks.\n\n    2. A user can only change or delete their own tasks\n \n    3. Without a valid token, no tasks\n       can be reached at all.",
      "fontSize": 29.52380719866071,
      "fontFamily": 1,
      "textAlign": "left",
